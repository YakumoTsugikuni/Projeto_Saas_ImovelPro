# Next.js SaaS Configuration

## Ambiente de Desenvolvimento

LOCAL_ENV=development
NODE_ENV=development

## Banco de Dados
# Use sua string de conexão PostgreSQL / Supabase aqui.
# Exemplo: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

## Supabase
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica"
# Chave secreta (Settings > API > service_role). Só no servidor, NUNCA com prefixo NEXT_PUBLIC_.
# Usada para enviar imagens ao Supabase Storage (bucket "imagens", criado automaticamente).
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

## NextAuth Configuration
NEXTAUTH_SECRET="seu-secret-aleatorio-aqui-mude-em-producao"
NEXTAUTH_URL="http://localhost:3000"

## Email (Resend - https://resend.com) - usado no "Esqueci minha senha"
# Sem a chave, em desenvolvimento o link aparece no terminal.
RESEND_API_KEY="re_..."
# Remetente. Para enviar a qualquer pessoa, verifique seu domínio no Resend.
EMAIL_FROM="ImóvelPro <nao-responda@seudominio.com.br>"

## API Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000"

## Optional: Email Service
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha"

## Optional: Cloud Storage
# AWS_ACCESS_KEY_ID="sua-chave"
# AWS_SECRET_ACCESS_KEY="sua-secret"
# AWS_S3_BUCKET="seu-bucket"
# AWS_REGION="us-east-1"

## Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="UA-XXXXXXXXX-X"
